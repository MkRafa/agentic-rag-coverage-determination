{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/protect_baseline.py\"",
            "timeout": 10,
            "statusMessage": "Checking baseline protection"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/baseline_staleness.py\"",
            "timeout": 10,
            "statusMessage": "Checking eval baseline staleness"
          }
        ]
      }
    ]
  }
}
