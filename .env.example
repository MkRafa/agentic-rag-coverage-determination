# Copy to `.env` (gitignored) or export these in your shell.
# Real environment variables always win over this file.

# ---------------------------------------------------------------------------
# Required for live (non-stub) runs
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Pinecone — only needed with CDA_VECTOR_BACKEND=pinecone.
# The default backend runs in-process and needs none of this.
#
#   pip install -e ".[pinecone]"
#   cda corpus index --backend pinecone          # one-off upsert
#   CDA_VECTOR_BACKEND=pinecone cda eval --diff
# ---------------------------------------------------------------------------
# PINECONE_API_KEY=pcsk_...
# CDA_VECTOR_BACKEND=local            # local | pinecone
# CDA_PINECONE_INDEX=policy-corpus
# CDA_PINECONE_NAMESPACE=default
# CDA_PINECONE_REGION=us-east-1
# CDA_PINECONE_MODEL=multilingual-e5-large

# ---------------------------------------------------------------------------
# Retrieval variants — swept by the eval, recorded in every trace
# ---------------------------------------------------------------------------
# CDA_MODEL=claude-opus-5             # swaps every role at once — use to price a suite run
# CDA_EMBEDDER=tfidf                  # tfidf | sentence-transformers
# CDA_RERANKER=date_aware             # rrf | weighted | date_aware
# CDA_CORPUS=corpus/generated/corpus.json   # point at an alternative corpus file

# ---------------------------------------------------------------------------
# Fault injection for stub runs (exercises the gate's rejection paths)
# ---------------------------------------------------------------------------
# CDA_STUB_FAULT=hallucinate          # hallucinate | paraphrase | stale | unsupported | lowconf
